\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{abnttools}[2025/09/16 v0.1.0 ABNT Tools for LaTeX Documents]

%-------------------------------------------------------------------------------
% 1. Processamento de Opções
%-------------------------------------------------------------------------------
% Usamos 'kvoptions' para um tratamento robusto de opções chave-valor.
\RequirePackage{kvoptions}

% Define a opção 'preset', que o usuário usará para especificar o tipo de
% documento (ex: academic, article). 'academic' é o valor padrão.
\DeclareStringOption[academic]{preset}

% Processa as opções que foram declaradas acima.
\ProcessKeyvalOptions*

%-------------------------------------------------------------------------------
% 2. Carregamento dos Módulos com base no Preset
%-------------------------------------------------------------------------------
% Informa ao log do LaTeX qual preset está sendo carregado. Útil para depuração.
\PackageInfo{abnttools}{Loading preset '\KV@abnttools@preset'}

% Tenta carregar um arquivo de configuração correspondente ao preset escolhido.
% Ex: Se o usuário usar [preset=article], este comando tentará carregar o
% arquivo 'abnt-preset-article.cfg'.
% O comando \InputIfFileExists é seguro e não gera erro se o arquivo não for
% encontrado, permitindo que o usuário crie seus próprios presets.
\InputIfFileExists{abnt-preset-\KV@abnttools@preset.cfg}{
    % Código a ser executado se o arquivo de preset for encontrado.
    % Deixamos em branco, pois o próprio arquivo fará o trabalho.
}{
    % Mensagem de erro se o preset não for encontrado.
    \PackageError{abnttools}{Preset '\KV@abnttools@preset' not found.}{%
        Ensure that a file named 'abnt-preset-\KV@abnttools@preset.cfg' exists.%
    }
}

%-------------------------------------------------------------------------------
% 3. Carregamento do Módulo Core (Sempre Necessário)
%-------------------------------------------------------------------------------
% O módulo 'abnt-core' contém as configurações fundamentais (margens, fontes,
% a macro \abntsetup, etc.) e deve ser carregado sempre, independentemente
% do preset.
\RequirePackage{abnt-core}

\endinput
% Fim do arquivo abnttools.sty